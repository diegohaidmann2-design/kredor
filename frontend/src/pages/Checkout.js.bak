import React, { useState, useEffect } from 'react';
import Layout from '../components/Layout';
import Button from '../components/Button';
import Loading from '../components/Loading';
import { checkoutAPI } from '../api/api';

const Checkout = () => {
  const [loading, setLoading] = useState(false);
  const [step, setStep] = useState('form'); // form, processing, pix, success, error
  const [metodo, setMetodo] = useState('pix');
  const [formData, setFormData] = useState({
    valor: '',
    descricao: '',
    nome: '',
    email: '',
    cpf: '',
    cartao_numero: '',
    cartao_validade: '',
    cartao_cvv: '',
    cartao_titular: ''
  });
  const [resultado, setResultado] = useState(null);
  const [error, setError] = useState('');
  const [pollInterval, setPollInterval] = useState(null);

  // Limpar polling ao desmontar
  useEffect(() => {
    return () => {
      if (pollInterval) clearInterval(pollInterval);
    };
  }, [pollInterval]);

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    setError('');
  };

  const formatCPF = (value) => {
    return value
      .replace(/\D/g, '')
      .replace(/(\d{3})(\d)/, '$1.$2')
      .replace(/(\d{3})(\d)/, '$1.$2')
      .replace(/(\d{3})(\d{1,2})/, '$1-$2')
      .replace(/(-\d{2})\d+?$/, '$1');
  };

  const formatCartao = (value) => {
    return value
      .replace(/\D/g, '')
      .replace(/(\d{4})(\d)/, '$1 $2')
      .replace(/(\d{4})(\d)/, '$1 $2')
      .replace(/(\d{4})(\d)/, '$1 $2')
      .replace(/(\d{4})\d+?$/, '$1');
  };

  const formatValidade = (value) => {
    return value
      .replace(/\D/g, '')
      .replace(/(\d{2})(\d)/, '$1/$2')
      .replace(/(\/\d{2})\d+?$/, '$1');
  };

  const handleCPFChange = (e) => {
    setFormData(prev => ({ ...prev, cpf: formatCPF(e.target.value) }));
  };

  const handleCartaoChange = (e) => {
    setFormData(prev => ({ ...prev, cartao_numero: formatCartao(e.target.value) }));
  };

  const handleValidadeChange = (e) => {
    setFormData(prev => ({ ...prev, cartao_validade: formatValidade(e.target.value) }));
  };

  const verificarStatus = async (paymentId) => {
    try {
      const response = await checkoutAPI.consultarStatus(paymentId);
      if (response.data.status === 'approved') {
        setStep('success');
        if (pollInterval) clearInterval(pollInterval);
      }
    } catch (err) {
      console.error('Erro ao verificar status:', err);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    setStep('processing');

    try {
      const payload = {
        valor: parseFloat(formData.valor),
        descricao: formData.descricao || 'Pagamento JuroFácil',
        metodo,
        nome: formData.nome,
        email: formData.email,
        cpf: formData.cpf.replace(/\D/g, ''),
      };

      if (metodo === 'cartao') {
        payload.cartao_numero = formData.cartao_numero.replace(/\s/g, '');
        payload.cartao_validade = formData.cartao_validade;
        payload.cartao_cvv = formData.cartao_cvv;
        payload.cartao_titular = formData.cartao_titular || formData.nome;
      }

      const response = await checkoutAPI.criarPagamento(payload);
      setResultado(response.data);

      if (metodo === 'pix') {
        setStep('pix');
        // Iniciar polling para verificar status
        const interval = setInterval(() => {
          verificarStatus(response.data.payment_id);
        }, 5000);
        setPollInterval(interval);
      } else {
        // Cartão - verificar se foi aprovado
        if (response.data.status === 'approved') {
          setStep('success');
        } else {
          setStep('error');
          setError('Pagamento não aprovado. Verifique os dados do cartão.');
        }
      }
    } catch (err) {
      setStep('error');
      setError(err.response?.data?.detail || 'Erro ao processar pagamento');
    } finally {
      setLoading(false);
    }
  };

  const resetForm = () => {
    setStep('form');
    setResultado(null);
    setError('');
    setFormData({
      valor: '',
      descricao: '',
      nome: '',
      email: '',
      cpf: '',
      cartao_numero: '',
      cartao_validade: '',
      cartao_cvv: '',
      cartao_titular: ''
    });
    if (pollInterval) clearInterval(pollInterval);
  };

  return (
    <Layout>
      <div className="container mx-auto px-4 py-8 max-w-2xl">
        <div className="mb-8 text-center">
          <h1 className="text-3xl font-bold text-gray-900" data-testid="checkout-title">
            Checkout
          </h1>
          <p className="text-gray-600 mt-1">Realize pagamentos via PIX ou Cartão de Crédito</p>
        </div>

        {/* Step: Formulário */}
        {step === 'form' && (
          <div className="bg-white rounded-lg shadow-md p-6" data-testid="checkout-form">
            {/* Seleção de Método */}
            <div className="mb-6">
              <label className="block text-sm font-medium text-gray-700 mb-3">Método de Pagamento</label>
              <div className="grid grid-cols-2 gap-4">
                <button
                  type="button"
                  onClick={() => setMetodo('pix')}
                  className={`p-4 border-2 rounded-lg flex flex-col items-center transition ${
                    metodo === 'pix' 
                      ? 'border-green-500 bg-green-50' 
                      : 'border-gray-200 hover:border-gray-300'
                  }`}
                  data-testid="metodo-pix"
                >
                  <div className="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-2">
                    <svg className="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12.5 2L6 8.5l3.5 3.5L6 15.5 12.5 22l6.5-6.5-3.5-3.5 3.5-3.5L12.5 2zm0 3.41L15.09 8.5 12.5 11.09 9.91 8.5l2.59-2.59zm0 8.18l2.59 2.59-2.59 2.59-2.59-2.59 2.59-2.59z"/>
                    </svg>
                  </div>
                  <span className="font-medium text-gray-900">PIX</span>
                  <span className="text-xs text-gray-500">Pagamento instantâneo</span>
                </button>

                <button
                  type="button"
                  onClick={() => setMetodo('cartao')}
                  className={`p-4 border-2 rounded-lg flex flex-col items-center transition ${
                    metodo === 'cartao' 
                      ? 'border-blue-500 bg-blue-50' 
                      : 'border-gray-200 hover:border-gray-300'
                  }`}
                  data-testid="metodo-cartao"
                >
                  <div className="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-2">
                    <svg className="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                  </div>
                  <span className="font-medium text-gray-900">Cartão de Crédito</span>
                  <span className="text-xs text-gray-500">Visa, Master, Elo</span>
                </button>
              </div>
            </div>

            <form onSubmit={handleSubmit}>
              {/* Valor e Descrição */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Valor (R$) *</label>
                  <input
                    type="number"
                    name="valor"
                    value={formData.valor}
                    onChange={handleChange}
                    min="1"
                    step="0.01"
                    required
                    placeholder="100.00"
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    data-testid="input-valor"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Descrição</label>
                  <input
                    type="text"
                    name="descricao"
                    value={formData.descricao}
                    onChange={handleChange}
                    placeholder="Assinatura mensal"
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    data-testid="input-descricao"
                  />
                </div>
              </div>

              {/* Dados do Pagador */}
              <div className="border-t border-gray-200 pt-4 mt-4">
                <h3 className="text-sm font-medium text-gray-700 mb-3">Dados do Pagador</h3>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Nome Completo *</label>
                    <input
                      type="text"
                      name="nome"
                      value={formData.nome}
                      onChange={handleChange}
                      required
                      placeholder="João da Silva"
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                      data-testid="input-nome"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">E-mail *</label>
                    <input
                      type="email"
                      name="email"
                      value={formData.email}
                      onChange={handleChange}
                      required
                      placeholder="joao@email.com"
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                      data-testid="input-email"
                    />
                  </div>
                  <div className="md:col-span-2">
                    <label className="block text-sm font-medium text-gray-700 mb-1">CPF *</label>
                    <input
                      type="text"
                      name="cpf"
                      value={formData.cpf}
                      onChange={handleCPFChange}
                      required
                      maxLength={14}
                      placeholder="000.000.000-00"
                      className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                      data-testid="input-cpf"
                    />
                  </div>
                </div>
              </div>

              {/* Dados do Cartão */}
              {metodo === 'cartao' && (
                <div className="border-t border-gray-200 pt-4 mt-4">
                  <h3 className="text-sm font-medium text-gray-700 mb-3">Dados do Cartão</h3>
                  <div className="grid grid-cols-1 gap-4">
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Número do Cartão *</label>
                      <input
                        type="text"
                        name="cartao_numero"
                        value={formData.cartao_numero}
                        onChange={handleCartaoChange}
                        required
                        maxLength={19}
                        placeholder="0000 0000 0000 0000"
                        className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
                        data-testid="input-cartao-numero"
                      />
                    </div>
                    <div className="grid grid-cols-3 gap-4">
                      <div>
                        <label className="block text-sm font-medium text-gray-700 mb-1">Validade *</label>
                        <input
                          type="text"
                          name="cartao_validade"
                          value={formData.cartao_validade}
                          onChange={handleValidadeChange}
                          required
                          maxLength={5}
                          placeholder="MM/AA"
                          className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
                          data-testid="input-cartao-validade"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium text-gray-700 mb-1">CVV *</label>
                        <input
                          type="text"
                          name="cartao_cvv"
                          value={formData.cartao_cvv}
                          onChange={(e) => setFormData(prev => ({ ...prev, cartao_cvv: e.target.value.replace(/\D/g, '').slice(0, 4) }))}
                          required
                          maxLength={4}
                          placeholder="123"
                          className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
                          data-testid="input-cartao-cvv"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium text-gray-700 mb-1">Titular</label>
                        <input
                          type="text"
                          name="cartao_titular"
                          value={formData.cartao_titular}
                          onChange={handleChange}
                          placeholder="Nome no cartão"
                          className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                          data-testid="input-cartao-titular"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {error && (
                <div className="mt-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg" data-testid="checkout-error">
                  {error}
                </div>
              )}

              <div className="mt-6">
                <Button
                  type="submit"
                  variant="primary"
                  className="w-full py-3 text-lg"
                  disabled={loading}
                  data-testid="checkout-submit"
                >
                  {loading ? 'Processando...' : `Pagar R$ ${formData.valor || '0.00'}`}
                </Button>
              </div>
            </form>
          </div>
        )}

        {/* Step: Processando */}
        {step === 'processing' && (
          <div className="bg-white rounded-lg shadow-md p-8 text-center">
            <Loading message="Processando pagamento..." />
          </div>
        )}

        {/* Step: PIX Gerado */}
        {step === 'pix' && resultado && (
          <div className="bg-white rounded-lg shadow-md p-6 text-center" data-testid="pix-result">
            <div className="mb-4">
              <div className="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg className="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h2 className="text-xl font-bold text-gray-900 mb-2">PIX Gerado com Sucesso!</h2>
              <p className="text-gray-600">Escaneie o QR Code ou copie o código para pagar</p>
            </div>

            {resultado.qr_code_base64 && (
              <div className="mb-4">
                <img 
                  src={`data:image/png;base64,${resultado.qr_code_base64}`} 
                  alt="QR Code PIX" 
                  className="mx-auto w-48 h-48 border-2 border-gray-200 rounded-lg"
                  data-testid="pix-qrcode"
                />
              </div>
            )}

            {resultado.qr_code && (
              <div className="mb-4">
                <label className="block text-sm font-medium text-gray-700 mb-2">Código PIX (Copia e Cola)</label>
                <div className="relative">
                  <textarea
                    readOnly
                    value={resultado.qr_code}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 text-sm font-mono resize-none"
                    rows={3}
                    data-testid="pix-code"
                  />
                  <button
                    onClick={() => navigator.clipboard.writeText(resultado.qr_code)}
                    className="absolute top-2 right-2 px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700"
                    data-testid="copy-pix-btn"
                  >
                    Copiar
                  </button>
                </div>
              </div>
            )}

            <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
              <p className="text-sm text-yellow-800">
                <strong>Aguardando pagamento...</strong><br/>
                O status será atualizado automaticamente após a confirmação.
              </p>
            </div>

            <p className="text-sm text-gray-500 mb-4">
              Gateway: <span className="font-medium">{resultado.gateway}</span> | 
              ID: <span className="font-mono">{resultado.payment_id}</span>
            </p>

            <Button onClick={resetForm} variant="secondary" data-testid="novo-pagamento-btn">
              Novo Pagamento
            </Button>
          </div>
        )}

        {/* Step: Sucesso */}
        {step === 'success' && (
          <div className="bg-white rounded-lg shadow-md p-8 text-center" data-testid="success-result">
            <div className="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg className="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h2 className="text-2xl font-bold text-gray-900 mb-2">Pagamento Aprovado!</h2>
            <p className="text-gray-600 mb-6">Seu pagamento foi processado com sucesso.</p>
            
            {resultado && (
              <div className="bg-gray-50 rounded-lg p-4 mb-6 text-left">
                <p className="text-sm text-gray-600"><strong>Valor:</strong> R$ {formData.valor}</p>
                <p className="text-sm text-gray-600"><strong>Gateway:</strong> {resultado.gateway}</p>
                <p className="text-sm text-gray-600"><strong>ID:</strong> {resultado.payment_id}</p>
              </div>
            )}

            <Button onClick={resetForm} variant="primary" data-testid="novo-pagamento-btn">
              Novo Pagamento
            </Button>
          </div>
        )}

        {/* Step: Erro */}
        {step === 'error' && (
          <div className="bg-white rounded-lg shadow-md p-8 text-center" data-testid="error-result">
            <div className="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg className="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <h2 className="text-2xl font-bold text-gray-900 mb-2">Erro no Pagamento</h2>
            <p className="text-red-600 mb-6">{error || 'Ocorreu um erro ao processar o pagamento.'}</p>
            
            <Button onClick={resetForm} variant="primary" data-testid="tentar-novamente-btn">
              Tentar Novamente
            </Button>
          </div>
        )}
      </div>
    </Layout>
  );
};

export default Checkout;
